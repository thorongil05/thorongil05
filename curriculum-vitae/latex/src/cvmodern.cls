%% cvmodern.cls — sidebar CV layout (navy sidebar + amber accent)
%% Content is generated by latex/build.cjs from data.json.
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{cvmodern}[2026/09/27 Sidebar CV]
\LoadClass[10pt]{article}

% ---------------------------------------------------------------- packages
\RequirePackage[a4paper,left=75mm,right=11mm,top=12mm,bottom=16mm,footskip=8mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{fontawesome5}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{refcount}
\RequirePackage{graphicx}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{ragged2e}

% ---------------------------------------------------------------- palette
\definecolor{navy}{HTML}{16233F}
\definecolor{navytwo}{HTML}{22345C}
\definecolor{ink}{HTML}{1E2433}
\definecolor{muted}{HTML}{5B6478}
\definecolor{cvline}{HTML}{DCE1EA}
\definecolor{accent}{HTML}{D9A441}
\definecolor{cvblue}{HTML}{2F5A9E}
\definecolor{chip}{HTML}{EEF2F8}
\definecolor{pubbg}{HTML}{FBF5E8}
\definecolor{sidetext}{HTML}{E6EAF2}
\definecolor{sidemuted}{HTML}{9FAECB}

% ---------------------------------------------------------------- fonts
\setmainfont{SourceSansPro}[
  Path=fonts/, Extension=.otf,
  UprightFont=*-Regular, BoldFont=*-Bold,
  ItalicFont=*-It, BoldItalicFont=*-BoldIt,
  FontFace={l}{n}{*-Light}, FontFace={sb}{n}{*-Semibold}]
\newcommand\light{\fontseries{l}\selectfont}
\newcommand\semibold{\fontseries{sb}\selectfont}
\newcommand\spaced[2][14]{{\addfontfeatures{LetterSpace=#1}#2}}

\color{ink}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.08}
\RaggedRight
\frenchspacing
\hyphenpenalty=10000
\exhyphenpenalty=10000

% ---------------------------------------------------------------- footer
\newcommand\cvfootername{}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\color{muted}\scriptsize\cvfootername{} — Curriculum Vitae}
\fancyfoot[R]{\color{muted}\scriptsize\thepage{} / \pageref*{LastPage}}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\footrule}{{\color{cvline}\hrule height\footrulewidth}\vspace{1.5mm}}

% ---------------------------------------------------------------- sidebar
% \sidebarpage{<n>}{<content>} registers sidebar content for page n.
\newcommand\sidebarpage[2]{\expandafter\def\csname cv@side@#1\endcsname{#2}}
\newcommand\sidebarbottom[1]{\def\cv@sidebottom{#1}}
\def\cv@sidebottom{}
\newlength\sidew \setlength\sidew{66mm}

\AddToShipoutPictureBG{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[navy] (current page.north west) rectangle ([xshift=\sidew]current page.south west);
    \node[anchor=north west,inner sep=0,text width=51mm,align=left,font=\color{sidetext}\small]
      at ([xshift=8mm,yshift=-12mm]current page.north west)
      {\csname cv@side@\the\value{page}\endcsname};
    \ifnum\value{page}=\getpagerefnumber{LastPage}\relax
      \node[anchor=south west,inner sep=0,text width=51mm,align=left,font=\color{sidemuted}\tiny]
        at ([xshift=8mm,yshift=12mm]current page.south west) {\cv@sidebottom};
    \fi
  \end{tikzpicture}}

% The photo is pre-rendered in a box: a tikzpicture nested inside the
% shipout overlay would inherit "overlay" and be misplaced.
\newsavebox\cv@photobox
\newcommand\setphoto[1]{\AtBeginDocument{\sbox\cv@photobox{%
  \begin{tikzpicture}
    \fill[accent!18] (0,0) circle (21.5mm);
    \begin{scope}
      \clip (0,0) circle (19mm);
      \node at (0,-3mm) {\includegraphics[width=40mm]{#1}};
    \end{scope}
    \draw[accent,line width=1.1mm] (0,0) circle (19.3mm);
  \end{tikzpicture}}}}
\newcommand\cvphoto{\makebox[\linewidth][c]{\usebox\cv@photobox}\par\vspace{7mm}}

\newcommand\sidesection[1]{%
  {\color{white}\bfseries\footnotesize\spaced[18]{\MakeUppercase{#1}}}%
  \hspace{2mm}{\color{white!25!navy}\leaders\hrule height 0.4pt depth -0.1pt\hfill}\par\vspace{2.6mm}}
\newcommand\sidegap{\par\vspace{6mm}}

\newcommand\contact[2]{\makebox[5mm][l]{\color{accent}\footnotesize#1}{\footnotesize#2}\par\vspace{1.6mm}}
\newcommand\sidelabel[1]{{\color{sidemuted}\scriptsize\spaced[10]{\MakeUppercase{#1}}}\par\vspace{1.2mm}}

\newtcbox{\sidechip}{on line,colback=navytwo,colframe=white!8!navytwo,boxrule=0.3pt,arc=1.2pt,
  left=2.2pt,right=2.2pt,top=0.6pt,bottom=0.6pt,boxsep=0pt,fontupper=\color{sidetext}\footnotesize}
\newtcbox{\sidechipcore}{on line,colback=accent,colframe=accent,boxrule=0pt,arc=1.2pt,
  left=2.2pt,right=2.2pt,top=0.6pt,bottom=0.6pt,boxsep=0pt,fontupper=\color{navy}\footnotesize\semibold}
\newcommand\chipgroup[1]{{\setlength{\baselineskip}{15pt}#1}\par\vspace{2.6mm}}

\newcommand\diamondbullet[1][accent]{\tikz[baseline=-0.6ex]\fill[#1,rotate=45] (0,0) rectangle (1.25mm,1.25mm);}
\newenvironment{sidelist}
  {\begin{itemize}[leftmargin=3.4mm,label=\diamondbullet,itemsep=0.9mm,topsep=0pt,parsep=0pt]\footnotesize}
  {\end{itemize}}
\newcommand\interest[2]{{\footnotesize{\color{white}\semibold #1}\ {\color{sidemuted}· #2}}\par\vspace{1.3mm}}

% ---------------------------------------------------------------- header
\newcommand\cvheader[3]{% first, last, role
  {\fontsize{28}{28}\selectfont\color{navy}{\light #1} \textbf{#2}}\par\vspace{2.5mm}
  {\tikz[baseline=-0.6ex]\fill[accent] (0,0) rectangle (4.5mm,0.8mm);\hspace{2mm}%
   \color{cvblue}\large\semibold\spaced[6]{\MakeUppercase{#3}}}\par\vspace{3.5mm}}
\newcommand\cvsummary[1]{%
  \begin{tcolorbox}[enhanced,blank,left=3.5mm,borderline west={0.8pt}{0pt}{cvline},fontupper=\color{muted}\small]
  #1\end{tcolorbox}}

% ---------------------------------------------------------------- sections
\newcommand\cvsection[1]{%
  \par\vspace{5.5mm}%
  {\diamondbullet[accent]\hspace{2mm}\color{navy}\large\bfseries\spaced[16]{\MakeUppercase{#1}}}%
  \hspace{2.5mm}{\color{cvline}\leaders\hrule height 0.5pt depth -0.1pt\hfill}\par\vspace{3mm}}

% ---------------------------------------------------------------- chips (main)
\newtcbox{\chip}{on line,colback=chip,colframe=chip,boxrule=0pt,arc=1.2pt,
  left=2.4pt,right=2.4pt,top=0.3pt,bottom=0.3pt,boxsep=0pt,fontupper=\color{cvblue}\scriptsize\semibold}
\newcommand\stack[1]{{\setlength{\baselineskip}{12pt}#1}\par}

% ---------------------------------------------------------------- experience
% Right-aligned date that moves to its own line (still right-aligned) if it does not fit.
\newcommand\cv@rightdate[1]{{\unskip\nobreak\hfil\penalty50\hskip1.5em\hbox{}\nobreak\hfill
  \mbox{\color{muted}\scriptsize\semibold\spaced[4]{#1}}}}
% \begin{cventry}{role}{org}{dates}{current: 1/0} ... \end{cventry}
\newenvironment{cventry}[4]{%
  \def\cv@dot{\ifnum#4=1 \fill[accent] ([xshift=1.1mm,yshift=-2.1mm]frame.north west) circle (1.25mm);%
              \else \filldraw[fill=white,draw=cvblue,line width=0.8pt] ([xshift=1.1mm,yshift=-2.1mm]frame.north west) circle (1.05mm);\fi}%
  \begin{tcolorbox}[enhanced,blank,unbreakable,left=5mm,bottom=3.6mm,
    overlay={\draw[cvline,line width=0.6pt] ([xshift=1.1mm,yshift=-3.4mm]frame.north west) -- ([xshift=1.1mm,yshift=1.5mm]frame.south west);\cv@dot}]
  {\color{navy}\bfseries\normalsize #1}\ifx\relax#2\relax\else{\color{navy}\bfseries\ ·\ }{\color{cvblue}\semibold\normalsize #2}\fi
  \cv@rightdate{#3}\par\vspace{1mm}}
  {\end{tcolorbox}}
\newenvironment{tasks}
  {\begin{itemize}[leftmargin=3.6mm,label={\color{accent}\raisebox{0.15ex}{\scriptsize\textbullet}},itemsep=0.5mm,topsep=0pt,parsep=0pt]\small}
  {\end{itemize}\vspace{1.4mm}}
\newcommand\hltask[1]{\item\textbf{#1}}
\newcommand\publication[3]{% title, venue, url
  \begin{tcolorbox}[enhanced,frame hidden,colback=pubbg,arc=1pt,sharp corners=west,
    borderline west={2.2pt}{0pt}{accent},left=3mm,right=2mm,top=1mm,bottom=1mm,fontupper=\footnotesize]
  {\color{navy}\bfseries Publication} — \href{#3}{\textit{#1}}, #2\end{tcolorbox}\vspace{1.2mm}}

% ---------------------------------------------------------------- education
% \cvedu{degree}{institution}{dates}{mark}{note}
\newcommand\cvedu[5]{%
  {\color{navy}\bfseries\normalsize #1}\hfill{\color{muted}\scriptsize\semibold\spaced[4]{#3}}\par
  {\color{cvblue}\semibold\small #2}\hfill{\color{navy}\bfseries\small #4}\par
  \ifx\relax#5\relax\else{\color{muted}\footnotesize #5}\par\fi
  \vspace{3mm}}

% ---------------------------------------------------------------- projects
\tcbset{cvproj/.style={enhanced,colback=white,colframe=cvline,boxrule=0.5pt,arc=1.5pt,
  borderline north={2.2pt}{0pt}{#1},left=2.6mm,right=2.6mm,top=2mm,bottom=2mm,fontupper=\footnotesize}}
% \cvproject[featured color]{name}{period}{description}{links}{chips}
\newcommand\cvproject[6][cvblue]{%
  \begin{tcolorbox}[cvproj=#1]
  {\color{navy}\bfseries\small #2}\hfill{\color{muted}\tiny\semibold\spaced[4]{#3}}\par\vspace{0.8mm}
  #4\par\vspace{0.8mm}
  \ifx\relax#5\relax\else{\color{cvblue}\scriptsize\semibold #5}\par\vspace{0.8mm}\fi
  \stack{#6}\end{tcolorbox}}
\newcommand\projlink[2]{\href{#1}{\faExternalLink*\ #2}}
